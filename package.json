{
  "name": "apk-builder",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "npm --prefix frontend run build",
    "android:setup": "node scripts/setup-android-sdk.js",
    "android:check": "node scripts/setup-android-sdk.js --check",
    "test:android-sdk": "node --test tests/android-sdk.test.js",
    "test:admin": "node --test tests/*.test.js && node frontend/tests/admin-management.test.mjs",
    "test:startup": "node --test frontend/tests/startup-recovery.test.mjs",
    "check:panel": "node scripts/check-panel-startup.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "archiver": "6.0.1",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "^8.6.2",
    "express-session": "1.19.0",
    "multer": "1.4.5-lts.1",
    "node-telegram-bot-api": "0.64.0",
    "sharp": "0.35.5",
    "unzipper": "0.10.14",
    "uuid": "9.0.0"
  },
  "devDependencies": {
    "nodemon": "3.0.3"
  },
  "overrides": {
    "request": {
      "form-data": "2.5.6"
    }
  }
}
