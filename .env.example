# ── Server ──
PORT=3000
SITE_NAME=ZAYRO BUILD
DB_NAME=zayrobuild.db
# Public URL where this panel is reachable (Telegram mini app / links ke liye)
SITE_URL=https://jaiclub5vip.site

# SESSION_SECRET: 32+ random characters. Production (NODE_ENV=production) me
# iska set hona zaroori hai. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Telegram Bot Configuration ──
# BotFather se. ⚠️ Bot me /revoke karke fresh token lein agar ye repo public me gaya tha.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Server & Firebase Live Links ──
BASE_URL=https://jaiclub5vip.site
FIREBASE_DATABASE_URL=
FIREBASE_DATABASE_AUTH=
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

# ── Admin Panel Credentials ──
ADMIN_USERNAME=admin
# bcrypt hash; plain password nahi. Banane ke liye:
#   node scripts/set-admin-password.js <new-password>
ADMIN_PASSWORD_HASH=

# ── APK Signing Keystore ──
KEYSTORE_ALIAS=zayro_build
KEYSTORE_PASSWORD=
APK_BUILD_VARIANT=release
APK_NATIVE_SECURITY=1
