# Dependencies (platform-specific binaries — VPS par `npm install` chalayein)
node_modules/
frontend/node_modules/

# Runtime junk
*.log
npm-debug.log*
.DS_Store
Thumbs.db
tmp/
.cache/

# Startup DB backups (server khud banata hai, repo me rakhne ki zaroorat nahi)
backups/

# Frontend build scratch
frontend/smoke/dist/
frontend/dist/

# ⚠️ .env aur firebase-service-account.json jaan-boojh kar repo me rakhe hain
# (aapki request — clone ke saath hi settings aa jaayein). Ye asli secrets hain,
# isliye repo ko private rakhna better hai, aur values rotate karte rahein.
.env.local
.env.*.local
*.pem

# Purane recovery/backup DB artifacts
database/*.bak.*
database/*.old_bak
database/*.before_recovery_*
database/apkbuilder_backup*

# SQLite runtime files (WAL/SHM har second badalte hain — DB file hi track hoti hai)
database/apkbuilder.db-wal
database/apkbuilder.db-shm

# NOTE: database/apkbuilder.db jaan-boojh kar tracked hai — isi me aapke templates,
# designs, settings aur users hain, aur VPS clone ke saath yahi data aana chahiye.

# Local binaries / build output (VPS par apne Linux binaries lein)
cloudflared.exe
cloudflared
backups/
builds/
